<%
/* orders.ejs — CHỈ phần thân riêng của trang. Header / drawer / footer / scripts do
   layouts/main.ejs lo.

   page-orders.js dựng danh sách đơn từ API. 96 dòng <style> của trang nằm ở partials/orders-style.ejs, nạp qua headExtra. */
-%>

    <div id="orders-wrapper">
        <div class="orders-heading" id="orders-heading">Đơn Hàng Của Tôi</div>

        <!-- Chưa đăng nhập -->
        <div class="orders-notice" id="orders-login" style="display:none;">
            <i class="fa fa-user-circle-o"></i>
            <span id="orders-login-text">Vui lòng đăng nhập để xem đơn hàng của bạn.</span>
            <br><br>
            <a href="login.html" id="orders-login-link">Đăng nhập</a>
        </div>

        <!-- Không có đơn -->
        <div class="orders-notice" id="orders-empty" style="display:none;">
            <i class="fa fa-shopping-bag"></i>
            <span id="orders-empty-text">Bạn chưa có đơn hàng nào.</span>
            <br><br>
            <a href="index.html" id="orders-empty-link">Tiếp tục mua sắm</a>
        </div>

        <!-- Đang tải / lỗi -->
        <div class="orders-notice" id="orders-status" style="display:none;"></div>
        <div class="orders-flash" id="orders-flash" role="status" hidden></div>

        <!-- Danh sách đơn -->
        <div id="orders-list"></div>

        <a href="index.html" class="orders-continue" id="orders-continue" style="display:none;">← Tiếp tục mua sắm</a>
    </div>

    <div class="orders-cancel-overlay" id="orders-cancel-overlay" hidden>
        <section class="orders-cancel-dialog" role="dialog" aria-modal="true" aria-labelledby="orders-cancel-title" tabindex="-1">
            <h2 id="orders-cancel-title">Hủy đơn hàng?</h2>
            <p id="orders-cancel-confirm">Bạn có chắc muốn hủy đơn hàng này?</p>
            <label for="orders-cancel-reason" id="orders-cancel-reason-label">Lý do hủy</label>
            <select id="orders-cancel-reason">
                <option value="">Chọn lý do</option>
                <option value="wrong_item">Đặt nhầm sản phẩm</option>
                <option value="change_item">Muốn thay đổi size/sản phẩm</option>
                <option value="change_address">Muốn thay đổi địa chỉ giao hàng</option>
                <option value="no_longer_needed">Không còn nhu cầu</option>
                <option value="other">Khác</option>
            </select>
            <label for="orders-cancel-details" id="orders-cancel-details-label" hidden>Chi tiết lý do</label>
            <textarea id="orders-cancel-details" maxlength="180" rows="3" hidden></textarea>
            <p class="orders-cancel-error" id="orders-cancel-error" role="alert" hidden></p>
            <div class="orders-cancel-actions">
                <button type="button" class="orders-cancel-back" id="orders-cancel-back" data-action="order-cancel-close">Quay lại</button>
                <button type="button" class="orders-cancel-submit" id="orders-cancel-submit" data-action="order-cancel-submit">Xác nhận hủy</button>
            </div>
        </section>
    </div>

