<%
/* product.ejs — CHỈ phần thân trang chi tiết sản phẩm.

   page-product.js đọc DOM 11 lần NGAY LÚC PARSE (nhiều thứ nhì toàn site) — nó nằm
   ở nhóm 6 cuối <body> nên markup này luôn có sẵn trước. Đừng dời script lên trên.

   Tham số ?id= vẫn do page-product.js tự đọc từ location.search như cũ; server KHÔNG
   đụng vào (xem mục S-1 trong CLEANUP.md — không truyền tham số URL vào to()).

   250 dòng <style> của trang này nằm ở partials/product-style.ejs, nạp qua headExtra. */
-%>

    <!-- ===== CHI TIẾT SẢN PHẨM ===== -->
    <div class="pd-wrap">
        <!-- .product-item để addToCart(this) đọc được name/price/img -->
        <div class="product-item" id="pd-root">
            <div class="pd-layout">
                <!-- Gallery lấy ảnh của màu được chọn, fallback về ảnh sản phẩm. -->
                <div class="pd-gallery" aria-label="Bộ ảnh sản phẩm" data-i18n-aria="pd.gallery">
                    <div class="pd-main">
                        <img id="pd-main-img" alt="" hidden>
                        <div class="pd-gallery-empty" id="pd-gallery-empty" aria-hidden="true">BREEZE</div>
                        <div class="pd-gallery-nav">
                            <button type="button" id="pd-prev" aria-label="Ảnh trước" data-i18n-aria="pd.prevImage" disabled><span aria-hidden="true">←</span></button>
                            <button type="button" id="pd-next" aria-label="Ảnh tiếp" data-i18n-aria="pd.nextImage" disabled><span aria-hidden="true">→</span></button>
                        </div>
                    </div>
                    <div class="pd-thumbs" id="pd-thumbs" aria-label="Ảnh thu nhỏ" data-i18n-aria="pd.thumbnails">
                        <!-- thumbnail được render bằng JS theo ?id -->
                    </div>
                </div>

                <!-- Thông tin -->
                <div class="pd-info">
                    <p class="pd-category" id="pd-category"></p>
                    <h1 class="pd-title product-name" id="pd-name">Sản phẩm</h1>
                    <div class="pd-price product-price" id="pd-price">0đ</div>

                    <div class="pd-color-group" id="pd-color-group" hidden>
                        <span class="pd-size-label" data-i18n="pd.chooseColor">Chọn màu</span>
                        <div class="pd-colors" id="pd-colors"></div>
                    </div>

                    <div class="pd-size-head">
                        <span class="pd-size-label" data-i18n="pd.chooseSize">Chọn size</span>
                        <button type="button" class="pd-guide-link" id="sg-open" data-i18n="pd.sizeGuide" style="display:none">Bảng size</button>
                    </div>
                    <div class="pd-sizes" id="pd-sizes">
                        <!-- Size được nạp từ product variants; không chọn sẵn. -->
                    </div>

                    <p class="pd-selection-status" id="pd-selection-status" role="status" aria-live="polite"></p>
                    <button type="button" class="pd-add" data-action="add-to-cart" disabled>Thêm vào giỏ</button>
                    <button type="button" class="pd-review" id="pd-review-open" aria-haspopup="dialog" aria-controls="pd-review-dialog" data-i18n="pd.reviewProduct" disabled>Đánh giá sản phẩm</button>
                    <p class="pd-review-hint" id="pd-review-access" role="status" hidden></p>
                    <a id="pd-review-login" data-i18n="com.signin" hidden>Đăng nhập</a>

                    <section class="pd-detail" id="pd-detail" hidden>
                        <h2 data-i18n="pd.details">Chi tiết sản phẩm</h2>
                        <p class="pd-desc" id="pd-desc"></p>
                    </section>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== ĐÁNH GIÁ SẢN PHẨM ===== -->
    <section class="pd-wrap pd-reviews" id="pd-reviews" aria-labelledby="pd-reviews-heading">
        <h2 id="pd-reviews-heading" data-i18n="pd.reviewSectionTitle">Đánh giá sản phẩm</h2>
        <div class="pd-reviews-summary" id="pd-reviews-summary" role="group" hidden>
            <p class="pd-reviews-score" id="pd-reviews-score" aria-hidden="true">— / 5</p>
            <span class="pd-reviews-stars" id="pd-reviews-stars" aria-hidden="true">☆☆☆☆☆</span>
            <p class="pd-reviews-total" id="pd-reviews-total" data-i18n="pd.reviewNoReviews">Chưa có đánh giá</p>
        </div>
        <div class="pd-reviews-filters" id="pd-reviews-filters" role="group" aria-label="Lọc đánh giá" data-i18n-aria="pd.reviewFilters">
            <button type="button" class="pd-reviews-filter is-active" data-review-filter="all" aria-pressed="true" aria-controls="pd-reviews-list" data-i18n="pd.reviewFilterAll">Tất cả</button>
            <button type="button" class="pd-reviews-filter" data-review-filter="5" aria-pressed="false" aria-controls="pd-reviews-list" data-i18n="pd.reviewFilter5">5 sao</button>
            <button type="button" class="pd-reviews-filter" data-review-filter="4" aria-pressed="false" aria-controls="pd-reviews-list" data-i18n="pd.reviewFilter4">4 sao</button>
            <button type="button" class="pd-reviews-filter" data-review-filter="3" aria-pressed="false" aria-controls="pd-reviews-list" data-i18n="pd.reviewFilter3">3 sao</button>
            <button type="button" class="pd-reviews-filter" data-review-filter="2" aria-pressed="false" aria-controls="pd-reviews-list" data-i18n="pd.reviewFilter2">2 sao</button>
            <button type="button" class="pd-reviews-filter" data-review-filter="1" aria-pressed="false" aria-controls="pd-reviews-list" data-i18n="pd.reviewFilter1">1 sao</button>
            <button type="button" class="pd-reviews-filter" data-review-filter="images" aria-pressed="false" aria-controls="pd-reviews-list" data-i18n="pd.reviewFilterImages">Có hình ảnh</button>
        </div>
        <div class="pd-reviews-list" id="pd-reviews-list"></div>
        <p class="pd-reviews-loading" id="pd-reviews-loading" role="status" data-i18n="pd.reviewListLoading" hidden>Đang tải đánh giá…</p>
        <div class="pd-reviews-error" id="pd-reviews-error" role="alert" hidden>
            <p data-i18n="pd.reviewListError">Không thể tải đánh giá.</p>
            <button type="button" class="pd-reviews-page" id="pd-reviews-retry" data-i18n="pd.reviewRetry">Thử lại</button>
        </div>
        <div class="pd-reviews-empty" id="pd-reviews-empty" role="status" hidden>
            <h3 data-i18n="pd.reviewNoReviews">Chưa có đánh giá</h3>
            <p id="pd-reviews-empty-description" data-i18n="pd.reviewEmptyDescription">Chưa có đánh giá nào cho sản phẩm này.</p>
        </div>
        <nav class="pd-reviews-pagination" id="pd-reviews-pagination" aria-label="Phân trang đánh giá" data-i18n-aria="pd.reviewPagination" hidden>
            <button type="button" class="pd-reviews-page" id="pd-reviews-prev" data-i18n="pd.reviewPrevious">← Trước</button>
            <span id="pd-reviews-page" aria-live="polite"></span>
            <button type="button" class="pd-reviews-page" id="pd-reviews-next" data-i18n="pd.reviewNext">Sau →</button>
        </nav>
    </section>

    <!-- ===== CÓ THỂ BẠN THÍCH ===== -->
    <div class="pd-wrap pd-related">
        <div class="main-content">
            <div class="headline reveal">
                <h4 data-i18n="pd.youMayLike">Có thể bạn thích</h4>
            </div>
            <ul class="products" id="pd-related-list">
                <li>
                    <div class="product-item reveal">
                        <div class="product-top">
                            <a href="product.html?id=chowonhee" class="product-thumb">
                                <img src="img/gc44.png" alt="Yêu mình trong những khoảng lặng">
                            </a>
                        </div>
                        <div class="product-info">
                            <a href="product.html?id=chowonhee" class="product-name">Yêu mình trong những khoảng lặng</a>
                            <div class="product-price">75,000đ</div>
                        </div>
                    </div>
                </li>
                <li>
                    <div class="product-item reveal">
                        <div class="product-top">
                            <a href="product.html?id=thuytran" class="product-thumb">
                                <img src="img/gc50.png" alt="Duyên đứt gánh">
                            </a>
                        </div>
                        <div class="product-info">
                            <a href="product.html?id=thuytran" class="product-name">Duyên đứt gánh</a>
                            <div class="product-price">115,000đ</div>
                        </div>
                    </div>
                </li>
                <li>
                    <div class="product-item reveal">
                        <div class="product-top">
                            <a href="product.html?id=bachiem" class="product-thumb">
                                <img src="img/gc56.png" alt="Ba chị em">
                            </a>
                        </div>
                        <div class="product-info">
                            <a href="product.html?id=bachiem" class="product-name">Ba chị em</a>
                            <div class="product-price">95,000đ</div>
                        </div>
                    </div>
                </li>
                <li>
                    <div class="product-item reveal">
                        <div class="product-top">
                            <a href="product.html?id=neubiet" class="product-thumb">
                                <img src="img/gc53.png" alt="Nếu biết trăm năm là hữu hạn">
                            </a>
                        </div>
                        <div class="product-info">
                            <a href="product.html?id=neubiet" class="product-name">Nếu biết trăm năm là hữu hạn</a>
                            <div class="product-price">239,000đ</div>
                        </div>
                    </div>
                </li>
            </ul>
        </div>
    </div>

    <!-- ===== MODAL BẢNG SIZE ===== -->
    <div class="sg-overlay" id="sg-overlay">
        <div class="sg-modal" role="dialog" aria-modal="true" aria-label="Bảng size" data-i18n-aria="pd.sizeGuide">
            <button type="button" class="sg-close" id="sg-close" aria-label="Đóng" data-i18n-aria="com.close">&times;</button>
            <h2 class="sg-title" data-i18n="pd.sizeGuide">Bảng size</h2>
            <p class="sg-sub" data-i18n="pd.sizeSub">Số đo tham khảo (cm). Chọn size lớn hơn nếu bạn thích form rộng.</p>
            <table class="sg-table">
                <thead>
                    <tr><th data-i18n="pd.thSize">Size</th><th data-i18n="pd.thChest">Ngực</th><th data-i18n="pd.thLength">Dài áo</th><th data-i18n="pd.thShoulder">Vai</th></tr>
                </thead>
                <tbody>
                    <tr><td>S</td><td>92</td><td>67</td><td>43</td></tr>
                    <tr><td>M</td><td>98</td><td>69</td><td>45</td></tr>
                    <tr><td>L</td><td>104</td><td>71</td><td>47</td></tr>
                    <tr><td>XL</td><td>110</td><td>73</td><td>49</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- ===== MODAL ĐÁNH GIÁ ===== -->
    <div class="pd-review-overlay" id="pd-review-overlay" hidden>
        <div class="pd-review-modal" id="pd-review-dialog" role="dialog" aria-modal="true" aria-labelledby="pd-review-title" aria-describedby="pd-review-subtitle">
            <button type="button" class="pd-review-close" id="pd-review-close" aria-label="Đóng" data-i18n-aria="com.close"><span aria-hidden="true">&times;</span></button>
            <div class="pd-review-header">
                <h2 id="pd-review-title" data-i18n="pd.writeReview">Viết đánh giá</h2>
                <p id="pd-review-subtitle" data-i18n="pd.reviewExperience">Chia sẻ trải nghiệm của bạn</p>
            </div>
            <div class="pd-review-product">
                <div class="pd-review-image">
                    <img id="pd-review-img" alt="" hidden>
                    <span id="pd-review-image-empty" aria-hidden="true">BREEZE</span>
                </div>
                <p id="pd-review-name"></p>
            </div>
            <div class="pd-review-content" id="pd-review-content">
                <form id="pd-review-form" novalidate>
                    <fieldset class="pd-review-field">
                        <legend id="pd-review-rating-label"><span data-i18n="pd.reviewRating">Đánh giá</span> <span aria-hidden="true">*</span></legend>
                        <div class="pd-review-stars" id="pd-review-stars" role="radiogroup" aria-labelledby="pd-review-rating-label" aria-required="true" aria-describedby="pd-review-rating-error">
                            <button type="button" class="pd-review-star" role="radio" data-review-rating="1" aria-checked="false" aria-label="1 sao" tabindex="0"><span aria-hidden="true">☆</span></button>
                            <button type="button" class="pd-review-star" role="radio" data-review-rating="2" aria-checked="false" aria-label="2 sao" tabindex="-1"><span aria-hidden="true">☆</span></button>
                            <button type="button" class="pd-review-star" role="radio" data-review-rating="3" aria-checked="false" aria-label="3 sao" tabindex="-1"><span aria-hidden="true">☆</span></button>
                            <button type="button" class="pd-review-star" role="radio" data-review-rating="4" aria-checked="false" aria-label="4 sao" tabindex="-1"><span aria-hidden="true">☆</span></button>
                            <button type="button" class="pd-review-star" role="radio" data-review-rating="5" aria-checked="false" aria-label="5 sao" tabindex="-1"><span aria-hidden="true">☆</span></button>
                        </div>
                        <p class="pd-review-error" id="pd-review-rating-error" role="alert" hidden></p>
                    </fieldset>
                    <div class="pd-review-field">
                        <label for="pd-review-variant"><span data-i18n="pd.reviewPurchasedVariant">Phân loại đã mua</span> <span aria-hidden="true">*</span></label>
                        <select id="pd-review-variant" required disabled aria-describedby="pd-review-variant-error">
                            <option value="" selected disabled data-i18n="pd.reviewChooseVariant">Chọn phân loại đã mua</option>
                        </select>
                        <p class="pd-review-error" id="pd-review-variant-error" role="alert" hidden></p>
                    </div>
                    <div class="pd-review-field">
                        <label for="pd-review-comment" data-i18n="pd.reviewComment">Bình luận</label>
                        <textarea id="pd-review-comment" rows="4" maxlength="1000" aria-describedby="pd-review-comment-count" placeholder="Chia sẻ cảm nhận của bạn về sản phẩm..." data-i18n-ph="pd.reviewCommentPlaceholder"></textarea>
                        <p class="pd-review-counter" id="pd-review-comment-count">0 / 1000</p>
                    </div>
                    <div class="pd-review-field">
                        <p class="pd-review-label" id="pd-review-images-label" data-i18n="pd.reviewImages">Hình ảnh</p>
                        <div class="pd-review-images">
                            <button type="button" class="pd-review-add-image" id="pd-review-add-image" aria-label="Thêm ảnh" data-i18n-aria="pd.reviewAddImage" aria-controls="pd-review-files" aria-describedby="pd-review-images-hint"><span aria-hidden="true">+</span></button>
                            <input type="file" id="pd-review-files" accept="image/png,image/jpeg,image/webp" multiple aria-labelledby="pd-review-images-label" hidden>
                            <div class="pd-review-previews" id="pd-review-previews"></div>
                        </div>
                        <p class="pd-review-hint" id="pd-review-images-hint" data-i18n="pd.reviewMaxImages">Tối đa 5 ảnh</p>
                        <p class="pd-review-error" id="pd-review-images-error" role="status" aria-live="polite" hidden></p>
                    </div>
                    <div class="pd-review-footer">
                        <button type="submit" class="pd-review-submit" id="pd-review-submit" data-i18n="pd.reviewSubmit" disabled>Gửi đánh giá</button>
                    </div>
                    <p class="pd-review-hint pd-review-feedback" id="pd-review-feedback" role="status" hidden></p>
                </form>
            </div>
        </div>
    </div>

    <!-- ===== XÁC NHẬN XÓA ĐÁNH GIÁ ===== -->
    <div class="pd-review-overlay" id="pd-review-delete-overlay" hidden>
        <div class="pd-review-delete-modal" id="pd-review-delete-dialog" role="alertdialog" aria-modal="true" aria-labelledby="pd-review-delete-title" aria-describedby="pd-review-delete-description" tabindex="-1">
            <h2 id="pd-review-delete-title" data-i18n="pd.reviewDeleteTitle">Xóa đánh giá?</h2>
            <p id="pd-review-delete-description" data-i18n="pd.reviewDeleteDescription">Bạn có chắc muốn xóa đánh giá này?</p>
            <div class="pd-review-delete-actions">
                <button type="button" class="pd-review-owner-action" id="pd-review-delete-cancel" data-i18n="com.cancel">Hủy</button>
                <button type="button" class="pd-review-owner-action pd-review-delete-confirm" id="pd-review-delete-confirm" data-i18n="com.delete">Xóa</button>
            </div>
            <p class="pd-review-hint pd-review-feedback" id="pd-review-delete-feedback" role="status" hidden></p>
        </div>
    </div>

