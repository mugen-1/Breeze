<%
/* profile.ejs — CHỈ phần thân riêng của trang. Header / drawer / footer / scripts do
   layouts/main.ejs lo.

   page-profile.js đọc DOM 19 LẦN ngay lúc parse — nhiều nhất toàn site. Markup này phải có đủ trước khi script chạy, nên script luôn ở cuối <body>. */
-%>

    <div id="settings-wrapper">
        <h1 class="settings-title" data-i18n="pf.title">Cài Đặt Tài Khoản</h1>

        <!-- Chưa đăng nhập -->
        <div class="settings-notice" id="profile-login" style="display:none;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/><circle cx="12" cy="10" r="3"/>
                <path d="M6.5 18.5c1-2.6 3-3.8 5.5-3.8s4.5 1.2 5.5 3.8"/>
            </svg>
            <span data-i18n="pf.needLogin">Vui lòng đăng nhập để xem cài đặt tài khoản.</span>
            <br><br>
            <a href="login.html?redirect=profile.html" data-i18n="com.signin">Đăng nhập</a>
        </div>

        <!-- Lỗi tải -->
        <div class="settings-notice" id="profile-status" style="display:none;"></div>

        <!-- Shell 2 cột: sidebar trái + panel phải -->
        <div class="settings-grid" id="settings-body" style="display:none;">
            <nav class="settings-nav" aria-label="Điều hướng cài đặt tài khoản" data-i18n-aria="pf.navAria">
                <a class="settings-nav-item" href="#account" data-section="account">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-6 8-6s8 2 8 6"/>
                    </svg>
                    <span data-i18n="pf.navAccount">Chi tiết tài khoản</span>
                </a>
                <a class="settings-nav-item" href="#addresses" data-section="addresses">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>
                    </svg>
                    <span data-i18n="pf.navAddresses">Địa chỉ giao hàng</span>
                </a>

                <a class="settings-nav-item" href="#payments" data-section="payments">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10.5h18"/>
                    </svg>
                    <span data-i18n="pf.navPayments">Phương thức thanh toán</span>
                </a>

                <a class="settings-nav-item" href="#theme" data-section="theme">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 8h8M17 8h3M4 16h3M12 16h8"/><circle cx="14.5" cy="8" r="2.2"/><circle cx="9.5" cy="16" r="2.2"/>
                    </svg>
                    <span data-i18n="pf.navTheme">Giao diện</span>
                </a>

                <a class="settings-nav-item" href="#privacy" data-section="privacy">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 3l7 3v5c0 4.6-3 8.2-7 10-4-1.8-7-5.4-7-10V6l7-3z"/>
                    </svg>
                    <span data-i18n="pf.navPrivacy">Quyền riêng tư</span>
                </a>
            </nav>

            <div class="settings-panel">
                <section class="settings-section" id="section-account" aria-labelledby="title-account">
                    <h2 class="settings-section-title" id="title-account" data-i18n="pf.navAccount">Chi tiết tài khoản</h2>

                    <!-- Khối 1: thông tin sẵn có (read-only, nguồn /api/me) -->
                    <div class="acct-block">
                        <div class="acct-block-title" data-i18n="pf.acctInfo">Thông tin tài khoản</div>
                        <div class="acct-fields acct-fields--ro">
                            <div class="acct-field">
                                <span class="acct-label" data-i18n="pf.fullname">Họ tên</span>
                                <span class="acct-value" id="ad-name">—</span>
                            </div>
                            <div class="acct-field">
                                <span class="acct-label">Email</span>
                                <span class="acct-value" id="ad-email">—</span>
                            </div>
                            <div class="acct-field">
                                <span class="acct-label" data-i18n="pf.password">Mật khẩu</span>
                                <span class="acct-value">
                                    <span class="acct-dots" aria-hidden="true">••••••••••</span>
                                    <button type="button" class="acct-edit" id="cp-open" data-i18n="pf.change">Đổi</button>
                                </span>
                            </div>
                            <div class="acct-field">
                                <span class="acct-label" data-i18n="pf.createdAt">Ngày tạo tài khoản</span>
                                <span class="acct-value" id="ad-created">—</span>
                            </div>
                            <div class="acct-field">
                                <span class="acct-label" data-i18n="pf.lastLogin">Đăng nhập gần nhất</span>
                                <span class="acct-value" id="ad-last">—</span>
                            </div>
                        </div>
                    </div>

                    <!-- Khối 2: field cá nhân MỚI — khung UI, để TRỐNG, CHƯA nối backend -->
                    <div class="acct-block">
                        <div class="acct-block-title" data-i18n="pf.personalInfo">Thông tin cá nhân</div>
                        <div class="acct-fields">
                            <div class="acct-field">
                                <label class="acct-label" for="ad-phone" data-i18n="pf.phone">Số điện thoại</label>
                                <input class="acct-input" id="ad-phone" type="tel" inputmode="tel"
                                       placeholder="Chưa cập nhật" data-i18n-ph="pf.notSet" autocomplete="tel">
                            </div>
                            <div class="acct-field">
                                <label class="acct-label" for="ad-dob" data-i18n="pf.dob">Ngày sinh</label>
                                <input class="acct-input" id="ad-dob" type="date"
                                       aria-label="Ngày sinh" data-i18n-aria="pf.dob" max="2025-12-31">
                            </div>
                            <div class="acct-field">
                                <label class="acct-label" for="ad-gender" data-i18n="pf.gender">Giới tính</label>
                                <select class="acct-input acct-select" id="ad-gender">
                                    <option value="" data-i18n="pf.genderNone">Chưa chọn</option>
                                    <option value="male" data-i18n="pf.genderMale">Nam</option>
                                    <option value="female" data-i18n="pf.genderFemale">Nữ</option>
                                </select>
                            </div>
                            <div class="acct-field">
                                <label class="acct-label" for="ad-country" data-i18n="pf.country">Quốc gia / Khu vực</label>
                                <select class="acct-input acct-select" id="ad-country">
                                    <option value="" data-i18n="pf.countryNone">— Chọn quốc gia —</option>
                                    <option value="VN" data-i18n="pf.cVN">Việt Nam</option>
                                    <option value="US" data-i18n="pf.cUS">Hoa Kỳ</option>
                                    <option value="JP" data-i18n="pf.cJP">Nhật Bản</option>
                                    <option value="KR" data-i18n="pf.cKR">Hàn Quốc</option>
                                    <option value="SG" data-i18n="pf.cSG">Singapore</option>
                                </select>
                            </div>
                        </div>
                        <div class="acct-save-row">
                            <button type="button" class="acct-save" id="ad-save" data-i18n="pf.saveChanges">Lưu thay đổi</button>
                        </div>
                    </div>

                    <!-- Lối tắt sẵn có: giữ nguyên -->
                    <div class="acct-actions">
                        <a class="acct-action" href="cart.html">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M6 8h12l1 12H5L6 8z"/><path d="M9 8a3 3 0 0 1 6 0"/>
                            </svg>
                            <span data-i18n="pf.myCart">Giỏ hàng của tôi</span>
                        </a>
                        <a class="acct-action" href="orders.html">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/>
                            </svg>
                            <span data-i18n="pf.myOrders">Đơn hàng của tôi</span>
                        </a>
                    </div>
                    <a class="acct-continue" href="index.html" data-i18n="pf.continueShopping">← Tiếp tục mua sắm</a>
                </section>

                <section class="settings-section" id="section-addresses" aria-labelledby="title-addresses">
                    <h2 class="settings-section-title" id="title-addresses" data-i18n="pf.navAddresses">Địa chỉ giao hàng</h2>

                    <!-- Live region: báo trạng thái tải cho screen reader (skeleton bị aria-hidden). -->
                    <p class="sr-only" id="addr-live" role="status" aria-live="polite"></p>

                    <div class="addr-head">
                        <p class="addr-head-desc" data-i18n="pf.addrDesc">Quản lý các địa chỉ giao hàng đã lưu. Địa chỉ mặc định sẽ được điền sẵn khi thanh toán.</p>
                        <button type="button" class="addr-add-btn" id="addr-add" hidden>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                            <span data-i18n="pf.addAddress">Thêm địa chỉ</span>
                        </button>
                    </div>

                    <!-- Loading skeleton -->
                    <div class="addr-skel-grid" id="addr-loading" aria-hidden="true">
                        <div class="addr-skel"><div class="addr-skel-line w-60"></div><div class="addr-skel-line w-40"></div><div class="addr-skel-line w-90"></div><div class="addr-skel-line w-60"></div></div>
                        <div class="addr-skel"><div class="addr-skel-line w-60"></div><div class="addr-skel-line w-40"></div><div class="addr-skel-line w-90"></div><div class="addr-skel-line w-60"></div></div>
                    </div>

                    <!-- Lỗi tải -->
                    <div class="addr-error" id="addr-error" hidden role="alert">
                        <p data-i18n="pf.addrLoadErr">Không tải được danh sách địa chỉ. Vui lòng thử lại.</p>
                        <button type="button" class="addr-btn addr-btn-ghost" id="addr-retry" data-i18n="pf.retry">Thử lại</button>
                    </div>

                    <!-- Empty state -->
                    <div class="addr-empty" id="addr-empty" hidden>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>
                        </svg>
                        <p class="addr-empty-title" data-i18n="pf.addrEmptyTitle">Bạn chưa lưu địa chỉ giao hàng nào</p>
                        <p class="addr-empty-desc" data-i18n="pf.addrEmptyDesc">Thêm địa chỉ để việc thanh toán ở lần mua kế tiếp nhanh hơn.</p>
                        <button type="button" class="addr-add-btn" id="addr-add-empty">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                            <span data-i18n="pf.addAddress">Thêm địa chỉ</span>
                        </button>
                    </div>

                    <!-- Danh sách địa chỉ -->
                    <div class="addr-list" id="addr-list" role="list" aria-label="Địa chỉ đã lưu" data-i18n-aria="pf.addrListAria" hidden></div>
                </section>

                <section class="settings-section" id="section-payments" aria-labelledby="title-payments">
                    <h2 class="settings-section-title" id="title-payments" data-i18n="pf.navPayments">Phương thức thanh toán</h2>

                    <!-- Live region: báo trạng thái tải cho screen reader -->
                    <p class="sr-only" id="pm-live" role="status" aria-live="polite"></p>

                    <div class="addr-head">
                        <p class="addr-head-desc" data-i18n="pf.payDesc">Quản lý các thẻ đã lưu. Thẻ mặc định sẽ được chọn sẵn khi thanh toán.</p>
                        <button type="button" class="addr-add-btn" id="pm-add" hidden>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                            <span data-i18n="pf.addCard">Thêm thẻ</span>
                        </button>
                    </div>

                    <!-- Loading skeleton -->
                    <div class="addr-skel-grid" id="pm-loading" aria-hidden="true">
                        <div class="addr-skel"><div class="addr-skel-line w-60"></div><div class="addr-skel-line w-40"></div><div class="addr-skel-line w-90"></div><div class="addr-skel-line w-60"></div></div>
                        <div class="addr-skel"><div class="addr-skel-line w-60"></div><div class="addr-skel-line w-40"></div><div class="addr-skel-line w-90"></div><div class="addr-skel-line w-60"></div></div>
                    </div>

                    <!-- Lỗi tải -->
                    <div class="addr-error" id="pm-error" hidden role="alert">
                        <p data-i18n="pf.payLoadErr">Không tải được danh sách thẻ. Vui lòng thử lại.</p>
                        <button type="button" class="addr-btn addr-btn-ghost" id="pm-retry" data-i18n="pf.retry">Thử lại</button>
                    </div>

                    <!-- Empty state -->
                    <div class="addr-empty" id="pm-empty" hidden>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10.5h18"/>
                        </svg>
                        <p class="addr-empty-title" data-i18n="pf.payEmptyTitle">Bạn chưa lưu thẻ nào</p>
                        <p class="addr-empty-desc" data-i18n="pf.payEmptyDesc">Thêm thẻ để việc thanh toán ở lần mua kế tiếp nhanh hơn.</p>
                        <button type="button" class="addr-add-btn" id="pm-add-empty">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                            <span data-i18n="pf.addCard">Thêm thẻ</span>
                        </button>
                    </div>

                    <!-- Danh sách thẻ -->
                    <div class="addr-list" id="pm-list" role="list" aria-label="Thẻ đã lưu" data-i18n-aria="pf.payListAria" hidden></div>
                </section>

                <section class="settings-section" id="section-theme" aria-labelledby="title-theme">
                    <h2 class="settings-section-title" id="title-theme" data-i18n="pf.navTheme">Giao diện</h2>
                    <p class="sr-only" id="theme-live" role="status" aria-live="polite"></p>
                    <p class="settings-desc" data-i18n="pf.themeDesc">Chọn giao diện cho Breeze. Lựa chọn được áp dụng trên tất cả các trang.</p>

                    <!-- Xem trước: CHỈ phản ánh trạng thái hiện tại, không bấm để chọn -->
                    <p class="theme-lbl" data-i18n="pf.preview">Xem trước</p>
                    <div class="theme-cards">
                        <div class="theme-card" data-theme-preview="light">
                            <div class="frame frame-light">
                                <div class="mini">
                                    <div class="mini-top">BREEZE</div>
                                    <div class="mini-body">
                                        <div class="mini-line"></div>
                                        <div class="mini-line short"></div>
                                        <div class="mini-btn">Mua</div>
                                    </div>
                                </div>
                            </div>
                            <div class="theme-card-foot"><span data-i18n="pf.light">Sáng</span></div>
                        </div>
                        <div class="theme-card" data-theme-preview="dark">
                            <div class="frame frame-dark">
                                <div class="mini">
                                    <div class="mini-top">BREEZE</div>
                                    <div class="mini-body">
                                        <div class="mini-line"></div>
                                        <div class="mini-line short"></div>
                                        <div class="mini-btn">Mua</div>
                                    </div>
                                </div>
                            </div>
                            <div class="theme-card-foot"><span data-i18n="pf.dark">Tối</span></div>
                        </div>
                    </div>

                    <!-- Thanh chọn thật: chỉ 2 nút Sáng/Tối -->
                    <p class="theme-lbl" data-i18n="pf.mode">Chế độ</p>
                    <div class="theme-seg" role="group" aria-label="Chọn giao diện" data-i18n-aria="pf.themeAria">
                        <button type="button" class="theme-seg-btn" data-theme-choice="light" data-i18n="pf.light">Sáng</button>
                        <button type="button" class="theme-seg-btn" data-theme-choice="dark" data-i18n="pf.dark">Tối</button>
                    </div>
                </section>

                <section class="settings-section" id="section-privacy" aria-labelledby="title-privacy">
                    <h2 class="settings-section-title" id="title-privacy" data-i18n="pf.navPrivacy">Quyền riêng tư</h2>
                    <p class="sr-only" id="privacy-live" role="status" aria-live="polite"></p>

                    <div class="avatar-block">
                        <span class="avatar-preview-wrap">
                            <!-- Chưa có ảnh -> ẩn img, hiện icon người mặc định.
                                 onerror cũng rơi về icon: ảnh có thể 404 trong khoảnh khắc
                                 vừa đổi avatar (file cũ đã bị dọn). -->
                            <img id="avatar-preview" class="avatar-preview" alt="Ảnh đại diện của bạn" data-i18n-alt="pf.avatarAlt" hidden>
                            <span id="avatar-fallback" class="avatar-fallback">
                                <i class="fa fa-user" aria-hidden="true"></i>
                            </span>
                        </span>
                        <div class="avatar-block-main">
                            <p class="privacy-row-title" id="pv-lbl-avatar" data-i18n="pf.avatar">Ảnh đại diện</p>
                            <p class="privacy-row-desc">
                                <span data-i18n="pf.avatarDesc">Ảnh hiện cạnh biểu tượng tài khoản trên mọi trang.</span>
                            </p>
                            <button type="button" class="avatar-pick-btn" id="avatar-pick"
                                    aria-describedby="pv-lbl-avatar" data-i18n="pf.pickImage">Chọn ảnh</button>
                            <!-- Bấm "Chọn ảnh" mở luôn trình chọn file của máy -->
                            <input type="file" id="avatar-input" hidden
                                   accept="image/png,image/jpeg,image/webp"
                                   aria-label="Chọn ảnh đại diện từ máy của bạn" data-i18n-aria="pf.pickImageAria">
                        </div>
                    </div>

                    <div id="privacy-rows">
                        <div class="privacy-row">
                            <div class="privacy-row-main">
                                <p class="privacy-row-title" id="pv-lbl-profile" data-i18n="pf.publicProfile">Hồ sơ công khai</p>
                                <p class="privacy-row-desc" data-i18n="pf.publicProfileDesc">Cho phép người dùng khác xem tên hiển thị và đánh giá của bạn.</p>
                            </div>
                            <span class="privacy-switch">
                                <input type="checkbox" id="pv-show_profile_public" data-privacy="show_profile_public"
                                       aria-labelledby="pv-lbl-profile">
                                <span class="privacy-track" aria-hidden="true"></span>
                            </span>
                        </div>

                        <div class="privacy-row">
                            <div class="privacy-row-main">
                                <p class="privacy-row-title" id="pv-lbl-mkt" data-i18n="pf.marketing">Email tiếp thị</p>
                                <p class="privacy-row-desc" data-i18n="pf.marketingDesc">Nhận email về bộ sưu tập mới, khuyến mãi và ưu đãi riêng.</p>
                            </div>
                            <span class="privacy-switch">
                                <input type="checkbox" id="pv-allow_marketing_email" data-privacy="allow_marketing_email"
                                       aria-labelledby="pv-lbl-mkt">
                                <span class="privacy-track" aria-hidden="true"></span>
                            </span>
                        </div>

                    </div>

                    <div class="danger-zone">
                        <p class="danger-zone-title" data-i18n="pf.deleteAccount">Xoá tài khoản</p>
                        <p class="danger-zone-desc">
                            <span data-i18n="pf.deleteDesc">Xoá vĩnh viễn tài khoản và dữ liệu cá nhân của bạn. Hành động này không thể hoàn tác.</span>
                        </p>
                        <button type="button" class="btn-danger" id="btn-delete-account" data-i18n="pf.deleteAccount">Xoá tài khoản</button>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <!-- Modal thêm/sửa địa chỉ (Phase 4) -->
    <div class="addr-modal-overlay" id="addr-modal-overlay" hidden>
        <div class="addr-modal" role="dialog" aria-modal="true" aria-labelledby="addr-modal-title" id="addr-modal">
            <div class="addr-modal-head">
                <h2 class="addr-modal-title" id="addr-modal-title" data-i18n="pf.addAddress">Thêm địa chỉ</h2>
                <button type="button" class="addr-modal-close" id="addr-modal-close" aria-label="Đóng" data-i18n-aria="pf.closeAria">&times;</button>
            </div>
            <form id="addr-form" novalidate>
                <div class="addr-modal-body">
                    <div class="addr-form-grid">
                        <div class="addr-form-field col-2">
                            <label class="acct-label" for="af-recipient"><span data-i18n="pf.recipient">Tên người nhận</span> <span class="addr-req" aria-hidden="true">*</span></label>
                            <input class="acct-input" id="af-recipient" type="text" autocomplete="name" maxlength="150" aria-describedby="af-recipient-msg" required>
                            <span class="addr-field-msg" id="af-recipient-msg"></span>
                        </div>
                        <div class="addr-form-field col-2">
                            <label class="acct-label" for="af-phone"><span data-i18n="pf.phone">Số điện thoại</span> <span class="addr-req" aria-hidden="true">*</span></label>
                            <input class="acct-input" id="af-phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="30" aria-describedby="af-phone-msg" required>
                            <span class="addr-field-msg" id="af-phone-msg"></span>
                        </div>
                        <div class="addr-form-field col-2">
                            <label class="acct-label" for="af-line1"><span data-i18n="pf.line1">Địa chỉ (số nhà, tên đường)</span> <span class="addr-req" aria-hidden="true">*</span></label>
                            <input class="acct-input" id="af-line1" type="text" autocomplete="address-line1" maxlength="200" aria-describedby="af-line1-msg" required>
                            <span class="addr-field-msg" id="af-line1-msg"></span>
                        </div>
                        <div class="addr-form-field col-2">
                            <label class="acct-label" for="af-line2"><span data-i18n="pf.line2">Căn hộ, toà nhà</span> <span class="addr-opt" data-i18n="pf.optional">(tuỳ chọn)</span></label>
                            <input class="acct-input" id="af-line2" type="text" autocomplete="address-line2" maxlength="200">
                        </div>
                        <div class="addr-form-field">
                            <label class="acct-label" for="af-ward" data-i18n="pf.ward">Phường / Xã</label>
                            <input class="acct-input" id="af-ward" type="text" maxlength="120">
                        </div>
                        <div class="addr-form-field">
                            <label class="acct-label" for="af-district" data-i18n="pf.district">Quận / Huyện</label>
                            <input class="acct-input" id="af-district" type="text" maxlength="120">
                        </div>
                        <div class="addr-form-field">
                            <label class="acct-label" for="af-city"><span data-i18n="pf.city">Tỉnh / Thành phố</span> <span class="addr-req" aria-hidden="true">*</span></label>
                            <input class="acct-input" id="af-city" type="text" autocomplete="address-level1" maxlength="120" aria-describedby="af-city-msg" required>
                            <span class="addr-field-msg" id="af-city-msg"></span>
                        </div>
                        <div class="addr-form-field">
                            <label class="acct-label" for="af-postal" data-i18n="pf.postal">Mã bưu chính</label>
                            <input class="acct-input" id="af-postal" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="20" aria-describedby="af-postal-msg">
                            <span class="addr-field-msg" id="af-postal-msg"></span>
                        </div>
                        <div class="addr-form-field col-2">
                            <label class="acct-label" for="af-country" data-i18n="pf.country">Quốc gia / Khu vực</label>
                            <select class="acct-input acct-select" id="af-country">
                                <option value="VN" data-i18n="pf.cVN">Việt Nam</option>
                                <option value="US" data-i18n="pf.cUS">Hoa Kỳ</option>
                                <option value="JP" data-i18n="pf.cJP">Nhật Bản</option>
                                <option value="KR" data-i18n="pf.cKR">Hàn Quốc</option>
                                <option value="SG" data-i18n="pf.cSG">Singapore</option>
                            </select>
                        </div>
                        <div class="addr-check-row">
                            <input type="checkbox" id="af-default">
                            <label for="af-default" data-i18n="pf.setDefaultAddr">Đặt làm địa chỉ mặc định</label>
                        </div>
                        <p class="addr-check-hint" id="af-default-hint" hidden data-i18n="pf.isDefaultHint">Đây đang là địa chỉ mặc định của bạn.</p>
                    </div>
                </div>
                <div class="addr-modal-foot">
                    <button type="button" class="addr-btn addr-btn-ghost" id="addr-cancel" data-i18n="com.cancel">Hủy</button>
                    <button type="submit" class="addr-btn addr-btn-primary" id="addr-submit" data-i18n="pf.saveAddress">Lưu địa chỉ</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal thêm/sửa thẻ (Phase 4) — căn giữa + blur nền. JS ở Phase 5. -->
    <div class="pm-modal-overlay" id="pm-modal-overlay" hidden>
        <div class="pm-modal" role="dialog" aria-modal="true" aria-labelledby="pm-modal-title">
            <div class="addr-modal-head">
                <h2 class="addr-modal-title" id="pm-modal-title" data-i18n="pf.addCard">Thêm thẻ</h2>
                <button type="button" class="addr-modal-close" id="pm-modal-close" aria-label="Đóng" data-i18n-aria="pf.closeAria">&times;</button>
            </div>
            <form id="pm-form" novalidate>
                <div class="addr-modal-body">
                    <div class="addr-form-grid">
                        <div class="addr-form-field col-2">
                            <label class="acct-label" for="pf-number" data-i18n="pf.cardNumber">Số thẻ</label>
                            <input class="acct-input" id="pf-number" type="text" inputmode="numeric" autocomplete="cc-number" maxlength="23" placeholder="1234 5678 9012 3456" aria-describedby="pf-number-hint pf-number-msg">
                            <span class="pm-hint" id="pf-number-hint" data-i18n="pf.cardNumberHint">Chỉ 4 số cuối được lưu lại. Để trống khi sửa nếu không đổi số thẻ.</span>
                            <span class="addr-field-msg" id="pf-number-msg"></span>
                        </div>
                        <div class="addr-form-field col-2">
                            <label class="acct-label" for="pf-holder" data-i18n="pf.cardHolder">Tên chủ thẻ</label>
                            <input class="acct-input" id="pf-holder" type="text" autocomplete="cc-name" maxlength="150" aria-describedby="pf-holder-msg">
                            <span class="addr-field-msg" id="pf-holder-msg"></span>
                        </div>
                        <div class="addr-form-field col-2">
                            <label class="acct-label" for="pf-month" data-i18n="pf.cardExpiry">Hết hạn</label>
                            <div class="pm-two">
                                <input class="acct-input" id="pf-month" type="text" inputmode="numeric" autocomplete="cc-exp-month" maxlength="2" placeholder="MM" aria-label="Tháng hết hạn (01–12)" data-i18n-aria="pf.expMonthAria" aria-describedby="pf-exp-msg">
                                <input class="acct-input" id="pf-year" type="text" inputmode="numeric" autocomplete="cc-exp-year" maxlength="4" placeholder="YYYY" aria-label="Năm hết hạn" data-i18n-aria="pf.expYearAria" aria-describedby="pf-exp-msg">
                            </div>
                            <span class="addr-field-msg" id="pf-exp-msg"></span>
                        </div>
                        <div class="addr-check-row">
                            <input type="checkbox" id="pf-default">
                            <label for="pf-default" data-i18n="pf.setDefaultPay">Đặt làm phương thức mặc định</label>
                        </div>
                    </div>
                </div>
                <div class="addr-modal-foot">
                    <button type="button" class="addr-btn addr-btn-ghost" id="pm-cancel" data-i18n="com.cancel">Hủy</button>
                    <button type="submit" class="addr-btn addr-btn-primary" id="pm-save" data-i18n="pf.saveCard">Lưu thẻ</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal đổi mật khẩu (Phase 2B) — bám đúng pattern modal "Thêm địa chỉ":
         cùng .addr-modal-overlay[hidden] + .is-open, cùng head/body/foot, cùng cặp nút.
         change-password.js lo phần hành vi; không script inline, không onclick. -->
    <div class="addr-modal-overlay" id="cp-modal-overlay" hidden>
        <div class="addr-modal" role="dialog" aria-modal="true" aria-labelledby="cp-modal-title" id="cp-modal">
            <div class="addr-modal-head">
                <h2 class="addr-modal-title" id="cp-modal-title" data-i18n="au.cpTitle">Đổi mật khẩu</h2>
                <button type="button" class="addr-modal-close" id="cp-modal-close" aria-label="Đóng" data-i18n-aria="pf.closeAria">&times;</button>
            </div>
            <form id="cp-form" novalidate>
                <div class="addr-modal-body">
                    <div class="addr-form-grid">
                        <div class="addr-form-field col-2">
                            <label class="acct-label" for="cp-current" data-i18n="au.cpCurrent">Mật khẩu hiện tại</label>
                            <div class="pw-wrap">
                                <input class="acct-input" id="cp-current" type="password" autocomplete="current-password" required>
                                <button type="button" class="pw-toggle" data-toggle-pw="cp-current"
                                        aria-controls="cp-current" aria-pressed="false"
                                        aria-label="Hiện mật khẩu" data-i18n-aria="au.cpShow">
                                    <i class="fa fa-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                        <div class="addr-form-field col-2">
                            <label class="acct-label" for="cp-new" data-i18n="au.cpNew">Mật khẩu mới</label>
                            <div class="pw-wrap">
                                <input class="acct-input" id="cp-new" type="password" autocomplete="new-password" required>
                                <button type="button" class="pw-toggle" data-toggle-pw="cp-new"
                                        aria-controls="cp-new" aria-pressed="false"
                                        aria-label="Hiện mật khẩu" data-i18n-aria="au.cpShow">
                                    <i class="fa fa-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                        <div class="addr-form-field col-2">
                            <label class="acct-label" for="cp-confirm" data-i18n="au.cpConfirm">Xác nhận mật khẩu mới</label>
                            <div class="pw-wrap">
                                <input class="acct-input" id="cp-confirm" type="password" autocomplete="new-password" required>
                                <button type="button" class="pw-toggle" data-toggle-pw="cp-confirm"
                                        aria-controls="cp-confirm" aria-pressed="false"
                                        aria-label="Hiện mật khẩu" data-i18n-aria="au.cpShow">
                                    <i class="fa fa-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <!-- Vùng thông báo dùng chung. Để TRỐNG: .addr-field-msg:empty tự ẩn,
                         nên không cần hidden hay style inline. -->
                    <p class="addr-field-msg" id="cp-msg" aria-live="polite"></p>
                </div>
                <div class="addr-modal-foot">
                    <button type="button" class="addr-btn addr-btn-ghost" id="cp-cancel" data-i18n="com.cancel">Hủy</button>
                    <button type="submit" class="addr-btn addr-btn-primary" id="cp-submit" data-i18n="au.cpSubmit">Đổi mật khẩu</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal xác nhận xoá tài khoản: bắt buộc nhập mật khẩu (server verify lại lần nữa) -->
    <div class="addr-modal-overlay" id="del-modal-overlay" hidden>
        <div class="addr-modal" role="dialog" aria-modal="true" aria-labelledby="del-modal-title" id="del-modal">
            <form id="del-form" novalidate>
                <div class="addr-modal-head">
                    <h2 class="addr-modal-title" id="del-modal-title" data-i18n="pf.deleteAccount">Xoá tài khoản</h2>
                </div>
                <div class="addr-modal-body">
                    <p class="danger-zone-desc" style="margin-bottom:12px;" data-i18n="pf.deleteIntro">Khi xoá tài khoản:</p>
                    <ul class="del-warn-list">
                        <li data-i18n="pf.deleteLi1">Thông tin cá nhân, địa chỉ và phương thức thanh toán sẽ bị xoá vĩnh viễn.</li>
                        <li data-i18n="pf.deleteLi2">Lịch sử đơn hàng được giữ lại nhưng ẩn danh (không còn gắn với bạn).</li>
                        <li data-i18n="pf.deleteLi3">Bạn không thể đăng nhập lại bằng tài khoản này.</li>
                    </ul>
                    <div class="addr-form-field col-2">
                        <label class="acct-label" for="del-password" data-i18n="pf.deletePwLabel">Nhập mật khẩu để xác nhận</label>
                        <input class="acct-input" id="del-password" type="password" autocomplete="current-password" required>
                    </div>
                    <p class="del-error" id="del-error" role="alert"></p>
                </div>
                <div class="addr-modal-foot">
                    <button type="button" class="addr-btn addr-btn-ghost" id="del-cancel" data-i18n="com.cancel">Hủy</button>
                    <button type="submit" class="btn-danger" id="del-confirm" data-i18n="pf.deleteConfirm">Xoá vĩnh viễn</button>
                </div>
            </form>
        </div>
    </div>

