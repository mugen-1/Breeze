<%
/* forgot-password.ejs — CHỈ phần thân riêng của trang. Header / drawer / footer / scripts do
   layouts/main.ejs lo.

   Trang tĩnh nhất trong nhóm auth: không có script riêng, auth-helper.js lo phần còn lại. */
-%>

    <div class="auth-body">
        <div class="auth-container">
            <div class="auth-logo">
                <!-- logo -->
            </div>

            <!-- TIEU DE -->
            <div class="auth-section-title" data-i18n="au.forgotTitle">Are you already a Breeze Club member in store?</div>
            <p class="auth-section-desc" data-i18n="au.forgotDesc">
                Please enter your email address.
                
            </p>
            <form onsubmit="event.preventDefault(); guiEmailDatLai();">

                <!-- EMAIL -->
                <div class="auth-input-group">
                    <input id="forgot-email"
                           class="auth-input"
                           type="email"
                           placeholder="* EMAIL ADDRESS" data-i18n-ph="au.phEmail"
                           required/>
                </div>

                <!-- THONG BAO -->
                <p id="forgot-msg" class="auth-msg"></p>

                <!-- NUT GUI -->
                <button type="submit" class="auth-btn" data-i18n="au.btnReset">SEND RESET LINK</button>

            </form>

            <!-- QUAY LAI TRANG DANG NHAP -->
            <a href="login.html" class="auth-back" data-i18n="au.backSignin">← Back to Sign in</a>

        </div>
    </div>

