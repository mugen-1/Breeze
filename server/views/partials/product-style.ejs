<style>
    /* ===== PRODUCT DETAIL ===== */
    .pd-wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: clamp(24px, 4vw, 56px) clamp(16px, 4vw, 48px) 0;
    }
    .pd-layout {
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        gap: clamp(28px, 4vw, 72px);
        align-items: start;
    }

    /* Gallery: thumbnail dọc bên trái + 1 ảnh lớn bên phải */
    .pd-gallery {
        display: grid;
        grid-template-columns: 76px 1fr;
        gap: 16px;
    }
    .pd-main {
        grid-column: 2;
        grid-row: 1;
        position: relative;
        overflow: hidden;
        aspect-ratio: 3 / 4;
        background: var(--c-cream);
    }
    .pd-main img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.7s var(--ease);
    }
    .pd-main:hover img {
        transform: scale(1.08);
    }
    .pd-thumbs {
        grid-column: 1;
        grid-row: 1;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .pd-thumb {
        width: 76px;
        aspect-ratio: 3 / 4;
        overflow: hidden;
        cursor: pointer;
        background: var(--c-cream);
        border: 1px solid var(--c-line);
        padding: 0;
        transition: border-color 0.2s;
    }
    .pd-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .pd-thumb.active {
        border-color: var(--c-ink);
    }

    /* Cột phải sticky */
    .pd-info {
        position: sticky;
        top: 28px;
        align-self: start;
    }
    .pd-title {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: clamp(30px, 4vw, 54px);
        line-height: 1.08;
        color: var(--c-ink);
        margin: 0;
    }
    .pd-price {
        font-family: var(--font-ui);
        font-size: 20px;
        color: var(--c-ink);
        margin: 18px 0 22px;
    }
    .pd-desc {
        display: block;
        font-family: var(--font-ui);
        font-size: 14px;
        line-height: 1.75;
        color: var(--c-muted);
        max-width: 48ch;
        margin: 0 0 30px;
    }

    /* Chọn size */
    .pd-size-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 12px;
    }
    .pd-size-label {
        font-family: var(--font-ui);
        font-size: 12px;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: var(--c-ink);
    }
    .pd-guide-link {
        font-family: var(--font-ui);
        font-size: 13px;
        color: var(--c-ink);
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
        background: none;
        border: none;
        padding: 0;
    }
    .pd-guide-link:hover { opacity: .6; }
    .pd-sizes {
        display: flex;
        gap: 10px;
        margin-bottom: 30px;
    }
    .pd-size {
        min-width: 54px;
        height: 50px;
        padding: 0 6px;
        border: 1px solid var(--c-line);
        background: transparent;
        font-family: var(--font-ui);
        font-size: 14px;
        color: var(--c-ink);
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
    }
    .pd-size:hover { border-color: var(--c-muted); }
    .pd-size.selected {
        border-color: var(--c-ink);
        box-shadow: inset 0 0 0 1px var(--c-ink);
        font-weight: 600;
    }

    /* Nút thêm giỏ full-width */
    .pd-add {
        display: block;
        width: 100%;
        padding: 17px;
        background: var(--c-ink);
        color: var(--c-bg);
        border: none;
        font-family: var(--font-ui);
        font-size: 13px;
        letter-spacing: 2px;
        text-transform: uppercase;
        cursor: pointer;
        transition: opacity 0.25s var(--ease);
    }
    .pd-add:hover { opacity: .85; }
    .pd-add.added { background: #2e7d32; }
    .pd-add:disabled, .pd-add.sold-out {
        background: var(--c-line); color: var(--c-muted); cursor: not-allowed; opacity: 1;
    }
    .pd-add:disabled:hover { opacity: 1; }
    .pd-soldout-note { margin: 12px 0 0; color: #a12833; font-size: 13px; letter-spacing: .3px; }

    /* ===== SIZE GUIDE MODAL ===== */
    .sg-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, .55);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s var(--ease), visibility 0.3s var(--ease);
        z-index: 2000;
    }
    .sg-overlay.open { opacity: 1; visibility: visible; }
    .sg-modal {
        background: var(--c-bg);
        max-width: 520px;
        width: 100%;
        padding: 34px 32px;
        position: relative;
        transform: translateY(14px);
        transition: transform 0.3s var(--ease);
    }
    .sg-overlay.open .sg-modal { transform: none; }
    .sg-close {
        position: absolute;
        top: 12px;
        right: 14px;
        background: none;
        border: none;
        font-size: 26px;
        line-height: 1;
        cursor: pointer;
        color: var(--c-ink);
    }
    .sg-close:hover { opacity: .6; }
    .sg-title {
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 28px;
        color: var(--c-ink);
        margin: 0 0 6px;
    }
    .sg-sub {
        font-family: var(--font-ui);
        font-size: 13px;
        color: var(--c-muted);
        margin: 0 0 20px;
    }
    .sg-table {
        width: 100%;
        border-collapse: collapse;
        font-family: var(--font-ui);
        font-size: 14px;
        color: var(--c-ink);
    }
    .sg-table th, .sg-table td {
        border: 1px solid var(--c-line);
        padding: 11px 12px;
        text-align: center;
    }
    .sg-table thead th { background: var(--c-cream); font-weight: 600; }

    /* ===== Section "Có thể bạn thích" ===== */
    .pd-related { margin-top: clamp(48px, 6vw, 96px); }
    .pd-related .main-content { padding-top: 0; }

    /* ===== Mobile ===== */
    @media (max-width: 860px) {
        .pd-layout { grid-template-columns: 1fr; gap: 28px; }
        .pd-info { position: static; }
        .pd-gallery { grid-template-columns: 1fr; }
        .pd-main { grid-column: 1; }
        .pd-thumbs {
            grid-column: 1;
            grid-row: 2;
            flex-direction: row;
            flex-wrap: wrap;
        }
    }
</style>
