<%
/* header.ejs — thanh đầu trang. Ba biến thể, đúng như hiện trạng đo được:

     'policy' (mặc định) — <div class="policy-header">, dùng ở 17/18 trang migrate.
                           Tên gọi gây hiểu nhầm: nó là <div>, KHÔNG phải <header>.
     'home'              — <header> riêng của index.html: logo + nav-toggle +
                           drawer-trigger + ô tìm kiếm .sbox + icon tài khoản.
     'none'              — không render gì (để dành cho trang tự dựng header).

   showSearchBox (mặc định FALSE) chỉ áp cho biến thể 'policy':
     false -> icon kính lúp link sang search  (16 trang)
     true  -> form tìm kiếm thật              (chỉ search)
   Mặc định PHẢI là false: quên truyền tham số thì hỏng về phía "hiện icon", chứ
   không phải "mọc thêm một form tìm kiếm thứ hai". Đây là phương án A chốt ở TASK 8.2.

   Mọi href đi qua R.href() -> PATHS trong client/js/routes.js. Không gõ '.html'.
*/
var _v = function (k, d) { return locals[k] === undefined ? d : locals[k]; };
var headerVariant = _v('headerVariant', 'policy');
var showSearchBox = _v('showSearchBox', false);
-%>
<% if (headerVariant === 'policy') { -%>
    <div class="policy-header">
        <button type="button" class="ph-menu" data-drawer-open aria-controls="drawer-menu" aria-expanded="false">
            <i class="fa fa-bars" aria-hidden="true"></i> <span class="ph-menu-label">Danh Mục</span>
        </button>
        <a href="<%= R.href('index') %>" class="ph-logo">BREEZE</a>
        <div class="ph-actions">
<% if (showSearchBox) { -%>
            <!-- Thay icon kính lúp bằng ô tìm kiếm thật (giống index), ngay cạnh icon tài khoản.
                 Submit GET -> search.html?q=... , cùng cách với thanh tìm kiếm ngoài index. -->
            <form class="ph-search" id="search-form" action="<%= R.href('search') %>" method="get" role="search">
                <input class="ph-search-input" id="search-input" type="text" name="q"
                       placeholder="Tìm sản phẩm..." data-i18n-ph="ix.searchPh" autocomplete="off" aria-label="Tìm sản phẩm" data-i18n-aria="ix.searchAria">
                <button class="ph-search-btn" type="submit" aria-label="Tìm kiếm" data-i18n-aria="ix.searchBtnAria">
                    <i class="fa fa-search" aria-hidden="true"></i>
                </button>
            </form>
<% } else { -%>
            <a href="<%= R.href('search') %>" aria-label="Tìm kiếm"><i class="fa fa-search" aria-hidden="true"></i></a>
<% } -%>
            <a href="<%= R.href('login') %>" aria-label="Tài khoản"><i class="fa fa-user" aria-hidden="true"></i></a>
        </div>
    </div>

<% } else if (headerVariant === 'home') { -%>
    <header>
        <div class="logo">
            <a href="<%= R.href('index') %>" class="brand">BREEZE</a>
        </div>
        <button class="nav-toggle" id="nav-toggle" data-drawer-open aria-label="M&#7903; menu" aria-controls="drawer-menu" aria-expanded="false">&#9776;</button>
        <div class="menu">
            <button type="button" class="drawer-trigger" data-drawer-open aria-controls="drawer-menu" aria-expanded="false">
                <span class="drawer-trigger-bars" aria-hidden="true">&#9776;</span> Danh M&#7909;c
            </button>
        </div>

        <div class="box">
            <form class="sbox" id="search-form" action="<%= R.href('search') %>" method="get">
                <input class="stext" type="text" name="q" placeholder="Search">
                <a class="sbutton" href="javascript:void(0);" onclick="document.getElementById('search-form').submit();">
                    <i class="fa fa-search"></i>
                </a>
            </form>
        </div>

        <a href="<%= R.href('login') %>" class="account-icon-btn" aria-label="Tài khoản"><i class="fa fa-user" aria-hidden="true"></i></a>

    </header>

<% } -%>
